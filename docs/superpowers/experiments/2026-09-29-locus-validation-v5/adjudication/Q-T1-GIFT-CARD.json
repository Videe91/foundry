    "documents_received": [
      {
        "key": "CUSTOMER-REFUND-T1",
        "text": "## Refunds for returned orders\n\nA customer who returns an order is refunded the price paid for the returned items."
      },
      {
        "key": "SUPPLIER-OVERPAYMENT-T1",
        "text": "## Supplier overpayments\n\nA supplier that has been paid more than its invoice total must pay the excess back."
      },
      {
        "key": "CHARGEBACK-T1",
        "text": "## Chargeback responses\n\nA chargeback must be answered within 7 days of the card network's notice."
      },
      {
        "key": "PAYOUT-T1",
        "text": "## Seller payouts\n\nSellers are paid out every Friday. A payout is made only when the seller's balance is at least 20 GBP."
      },
      {
        "key": "CONVERSION-T1",
        "text": "## Currency conversion\n\nA payment made in a foreign currency is converted at that day's reference exchange rate."
      },
      {
        "key": "STORE-CREDIT-T1",
        "text": "## Store credit\n\nStore credit expires 12 months after it is issued."
      },
      {
        "key": "GIFT-CARD-T1",
        "text": "## Gift cards\n\nA gift card can pay for any order. A gift card balance never expires."
      },
      {
        "key": "INVOICE-T1",
        "text": "## Business invoices\n\nEvery order placed by a business customer receives a VAT invoice."
      },
      {
        "key": "RETRY-T1",
        "text": "## Failed subscription payments\n\nA failed subscription payment is tried again 3 days later. It is tried again at most three times."
      },
      {
        "key": "CARD-CHECK-T1",
        "text": "## Saving a payment card\n\nA new payment card is checked with a zero-amount authorisation before it is saved."
      },
      {
        "key": "FRAUD-HOLD-T1",
        "text": "## Fraud review holds\n\nAn order flagged by fraud screening is held until an analyst has reviewed it."
      },
      {
        "key": "CAPTURE-T1",
        "text": "## Card payment capture\n\nA card payment is captured when the order is dispatched, not when it is placed."
      },
      {
        "key": "SELLER-LIMIT-T1",
        "text": "## New seller payment limit\n\nA new seller account may receive at most 1,000 GBP in payments during its first 30 days."
      },
      {
        "key": "PRICE-VAT-T1",
        "text": "## Displayed prices\n\nPrices shown to consumers include VAT."
      },
      {
        "key": "INSTALMENTS-T1",
        "text": "## Instalment plans\n\nAn order may be paid in three monthly instalments."
      },
      {
        "key": "PROMO-T1",
        "text": "## Promotional codes\n\nOnly one promotional code can be applied to an order."
      }
    ],
